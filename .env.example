# Unsplash（只在本機抓圖時使用：npm run images）
UNSPLASH_ACCESS_KEY=

# 表單回傳：Google Apps Script Web App 網址與共用密鑰（見 apps-script/README.md）
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Cloudflare Turnstile（選用，防機器人）
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# LINE 官方帳號加好友連結，例如 https://lin.ee/xxxxxxx
PUBLIC_LINE_URL=

# GA4 評估 ID（選用），例如 G-XXXXXXX
PUBLIC_GA_ID=
