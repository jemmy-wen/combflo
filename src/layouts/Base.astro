---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'CombFlo 流程工廠｜梳理流程，順出產能',
  description = '走進一間台灣傳統工廠，看看流程梳理前後會有什麼改變。回答 9 個問題，找出你的公司有哪些潛在問題。',
} = Astro.props;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
    <script is:inline>
      try {
        var p = new URLSearchParams(location.search), k = 'cf_utm';
        if (!sessionStorage.getItem(k)) {
          var o = { referrer: document.referrer || '' };
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (n) { if (p.get(n)) o[n] = p.get(n); });
          sessionStorage.setItem(k, JSON.stringify(o));
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
